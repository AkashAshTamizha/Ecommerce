// ============================================================
// E-Commerce + Inventory Management — Prisma Schema
// Multi-vendor marketplace: Super Admin / Seller / Customer
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  SELLER
  ACCOUNTANT
  STOCK_MANAGER
  DELIVERY_AGENT
  CUSTOMER
}

enum ShipmentStatus {
  CREATED
  PACKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  LOW_STOCK
  DRAFT
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  TRANSFER
  ADJUSTMENT
  ORDER_RESERVED
  ORDER_RELEASED
  RETURN_RESTOCK
  DAMAGED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ------------------------------------------------------------
// OFFERS / COUPONS / DISCOUNTS
// ------------------------------------------------------------

// COUPON  = customer must enter a code at checkout for it to apply.
// AUTOMATIC = applied on its own to every qualifying order, no code needed.
enum ReturnRequestType {
  RETURN
  REPLACEMENT
}

enum ReturnRequestReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_FIT_ISSUE
  NO_LONGER_NEEDED
  QUALITY_ISSUE
  OTHER
}

// Two parallel tracks after RECEIVED: a RETURN ends in REFUNDED, a
// REPLACEMENT ends in REPLACEMENT_DELIVERED. See returnRequest.controller.js
// for the exact allowed transitions per type.
enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  REPLACEMENT_SHIPPED
  REPLACEMENT_DELIVERED
  REFUNDED
  CANCELLED
}

enum RefundMethod {
  ORIGINAL_PAYMENT_METHOD
  STORE_CREDIT
  BANK_TRANSFER
}

enum OfferType {
  COUPON
  AUTOMATIC
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// What the offer's discount applies to: the whole cart, a single
// category, a single brand, or a single product.
enum OfferScope {
  ALL
  CATEGORY
  BRAND
  PRODUCT
}

// ------------------------------------------------------------
// VENDOR RETURNS / CREDIT NOTES
// Tracks damaged or otherwise unacceptable stock sent back to a
// Vendor, and the credit notes vendors issue us in exchange (or the
// replacement stock they send instead).
// ------------------------------------------------------------

enum VendorReturnReason {
  DAMAGED
  DEFECTIVE
  EXPIRED
  WRONG_ITEM
  EXCESS_SUPPLY
  QUALITY_ISSUE
  OTHER
}

enum VendorReturnStatus {
  DRAFT
  SENT_TO_VENDOR
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

// How a vendor return was ultimately settled. PENDING until the vendor
// responds; then either a credit note is issued against future purchase
// orders, physical replacement stock is sent, a cash refund is paid, or
// the vendor rejects the claim outright.
enum VendorReturnResolution {
  PENDING
  CREDIT_NOTE
  REPLACEMENT
  REFUND
  REJECTED
}

enum VendorCreditNoteStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  CANCELLED
}

// ------------------------------------------------------------
// AUTH / USERS
// ------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  role          Role      @default(CUSTOMER)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  refreshToken  String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  seller             Seller?
  warehouseStaffOf   Warehouse[]      @relation("WarehouseStaff")
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  purchaseOrdersMade PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  shipmentsAssigned  Shipment[]       @relation("ShipmentDeliveryAgent")
  addresses          Address[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  vendorReturnsMade  VendorReturn[]   @relation("VendorReturnCreatedBy")
  creditNotesMade    VendorCreditNote[] @relation("VendorCreditNoteCreatedBy")
  creditNoteApplicationsMade VendorCreditNoteApplication[] @relation("CreditNoteApplicationAppliedBy")
  offerRedemptions   OfferRedemption[]
  returnRequestsMade     ReturnRequest[] @relation("ReturnRequestCustomer")
  returnRequestsResolved ReturnRequest[] @relation("ReturnRequestResolvedBy")
  reviews                Review[]

  @@index([role])
  @@map("users")
}

// ------------------------------------------------------------
// CUSTOMER ADDRESS BOOK
// ------------------------------------------------------------

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home") // Home, Work, Other
  fullName    String
  phone       String
  addressLine String
  landmark    String?
  city        String
  state       String
  country     String   @default("India")
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

// ------------------------------------------------------------
// CART & WISHLIST (storefront)
// ------------------------------------------------------------

model CartItem {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, productId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

// ------------------------------------------------------------
// SELLER
// ------------------------------------------------------------

model Seller {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName     String
  storeLogoUrl  String?
  storeBannerUrl String?
  gstNumber     String?
  businessType  String?
  addressLine   String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  status        SellerStatus   @default(PENDING)
  commissionPct Decimal        @default(10) @db.Decimal(5, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  products      Product[]
  documents     SellerDocument[]
  warehouses    Warehouse[]
  payouts       Payout[]

  @@index([status])
  @@map("sellers")
}

model SellerDocument {
  id         String   @id @default(uuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  docType    String   // PAN, GST, BUSINESS_LICENSE, ADDRESS_PROOF, BANK_STATEMENT, CANCELLED_CHEQUE
  fileUrl    String
  status     ApprovalStatus @default(PENDING)
  uploadedAt DateTime @default(now())

  @@map("seller_documents")
}

// ------------------------------------------------------------
// CATALOG: CATEGORY / BRAND / ATTRIBUTES
// ------------------------------------------------------------

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  products     Product[]
  offers       Offer[]

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]
  offers    Offer[]

  @@map("brands")
}

model Attribute {
  id        String            @id @default(uuid())
  name      String            @unique // Color, Storage, RAM, Size, Material
  type      String            @default("dropdown")
  isActive  Boolean           @default(true)
  values    AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String     @id @default(uuid())
  attributeId String
  attribute   Attribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String

  @@unique([attributeId, value])
  @@map("attribute_values")
}

// ------------------------------------------------------------
// PRODUCT
// ------------------------------------------------------------

model Product {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  sku             String         @unique
  barcode         String?
  shortDesc       String?
  fullDesc        String?

  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?         @relation(fields: [brandId], references: [id])
  sellerId        String
  seller          Seller         @relation(fields: [sellerId], references: [id])

  mrp             Decimal        @db.Decimal(12, 2)
  sellingPrice    Decimal        @db.Decimal(12, 2)
  costPrice       Decimal?       @db.Decimal(12, 2)
  discountType    String?        // PERCENTAGE | FLAT
  discountValue   Decimal?       @db.Decimal(12, 2)
  taxPct          Decimal        @default(0) @db.Decimal(5, 2)

  weightKg        Decimal?       @db.Decimal(8, 3)
  lengthCm        Decimal?       @db.Decimal(8, 2)
  widthCm         Decimal?       @db.Decimal(8, 2)
  heightCm        Decimal?       @db.Decimal(8, 2)
  shippingClass   String?
  shipsFrom       String?

  metaTitle       String?
  metaDescription String?
  urlSlug         String?

  status          ProductStatus  @default(DRAFT)
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?

  minStockLevel   Int            @default(5)
  maxStockLevel   Int            @default(100)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  images          ProductImage[]
  variants        ProductVariant[]
  inventories     Inventory[]
  reviews         Review[]
  orderItems      OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  vendorReturnItems VendorReturnItem[]
  offers          Offer[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([approvalStatus])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // When set, this image belongs to a specific variant's own gallery
  // (front/primary image + other images) rather than the product's
  // general gallery. productId is still kept so a variant image can be
  // cleaned up via the same cascade as everything else on the product.
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url        String
  publicId   String   // Cloudinary public_id, needed for deletion
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([variantId])
  @@map("product_images")
}

model ProductVariant {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String      @unique
  attributes   Json        // e.g. { "Color": "Black", "Storage": "128GB" }
  price        Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  // Deprecated: legacy free-text image URL, kept only so old rows still
  // render something. New variants use `images` (uploaded via Cloudinary)
  // instead — the isPrimary one there is the "front" image, the rest are
  // "other" images shown in the gallery.
  imageUrl     String?
  images       ProductImage[]
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  inventories  Inventory[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  vendorReturnItems VendorReturnItem[]

  @@map("product_variants")
}

// ------------------------------------------------------------
// WAREHOUSE & INVENTORY
// ------------------------------------------------------------

model Warehouse {
  id          String     @id @default(uuid())
  sellerId    String?
  seller      Seller?    @relation(fields: [sellerId], references: [id])
  name        String
  code        String     @unique
  addressLine String?
  city        String?
  state       String?
  country     String?
  pincode     String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  staff       User[]     @relation("WarehouseStaff")
  inventories Inventory[]
  movements   StockMovement[]
  purchaseOrders PurchaseOrder[]
  shipments   Shipment[]
  orderItems  OrderItem[]
  vendorReturns VendorReturn[]

  @@map("warehouses")
}

// ------------------------------------------------------------
// VENDORS (supply-side — who we purchase stock FROM)
// Kept separate from Seller (who sells ON the marketplace),
// even though the two are conceptually similar "partner" records.
// ------------------------------------------------------------

model Vendor {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  email         String?  @unique
  phone         String?
  addressLine   String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  gstNumber     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  vendorReturns  VendorReturn[]
  creditNotes    VendorCreditNote[]

  @@index([isActive])
  @@map("vendors")
}

// ------------------------------------------------------------
// PURCHASE ORDERS (buying stock IN from a Vendor)
// ------------------------------------------------------------

model PurchaseOrder {
  id            String              @id @default(uuid())
  poNumber      String              @unique
  vendorId      String
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  warehouseId   String
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  status        PurchaseOrderStatus @default(DRAFT)
  subtotal      Decimal             @default(0) @db.Decimal(12, 2)
  tax           Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal             @default(0) @db.Decimal(12, 2)
  expectedDate  DateTime?
  notes         String?
  createdById   String?
  createdBy     User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         PurchaseOrderItem[]
  vendorReturns VendorReturn[]
  creditNoteApplications VendorCreditNoteApplication[]

  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// ------------------------------------------------------------
// VENDOR RETURNS (damaged/defective/wrong stock sent back to a Vendor)
// and VENDOR CREDIT NOTES (the credit a Vendor issues us in exchange,
// which gets drawn down against future Purchase Orders).
// ------------------------------------------------------------

model VendorReturn {
  id              String                  @id @default(uuid())
  returnNumber    String                  @unique
  vendorId        String
  vendor          Vendor                  @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse               @relation(fields: [warehouseId], references: [id])

  reason          VendorReturnReason
  status          VendorReturnStatus      @default(DRAFT)
  resolution      VendorReturnResolution  @default(PENDING)

  // Total cost value of the returned goods (sum of item lines), used to
  // sanity-check that any credit note issued against this return doesn't
  // exceed what was actually sent back.
  totalValue      Decimal                 @default(0) @db.Decimal(12, 2)

  notes           String?
  sentAt          DateTime?
  resolvedAt      DateTime?

  createdById     String?
  createdBy       User?                   @relation("VendorReturnCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  items           VendorReturnItem[]
  creditNotes     VendorCreditNote[]

  @@index([vendorId])
  @@index([status])
  @@index([warehouseId])
  @@map("vendor_returns")
}

model VendorReturnItem {
  id             String             @id @default(uuid())
  vendorReturnId String
  vendorReturn   VendorReturn       @relation(fields: [vendorReturnId], references: [id], onDelete: Cascade)
  productId      String
  product        Product            @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant?    @relation(fields: [variantId], references: [id])

  quantity       Int
  unitCost       Decimal            @db.Decimal(12, 2)
  totalCost      Decimal            @db.Decimal(12, 2)

  // Item-level override — most returns share one reason, but a mixed
  // shipment (e.g. some damaged, some just wrong) can vary per line.
  reason         VendorReturnReason?
  condition      String?

  @@map("vendor_return_items")
}

model VendorCreditNote {
  id               String                 @id @default(uuid())
  creditNoteNumber String                 @unique
  vendorId         String
  vendor           Vendor                 @relation(fields: [vendorId], references: [id])
  vendorReturnId   String?
  vendorReturn     VendorReturn?          @relation(fields: [vendorReturnId], references: [id])

  amount           Decimal                @db.Decimal(12, 2)
  appliedAmount    Decimal                @default(0) @db.Decimal(12, 2)
  status           VendorCreditNoteStatus @default(OPEN)

  issuedDate       DateTime               @default(now())
  expiryDate       DateTime?
  notes            String?

  createdById      String?
  createdBy        User?                  @relation("VendorCreditNoteCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  applications     VendorCreditNoteApplication[]

  @@index([vendorId])
  @@index([status])
  @@map("vendor_credit_notes")
}

// Draws a credit note down against a specific future Purchase Order —
// keeps a full audit trail of how each credit note was actually used,
// since a single note is often applied across more than one PO.
model VendorCreditNoteApplication {
  id              String           @id @default(uuid())
  creditNoteId    String
  creditNote      VendorCreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  amountApplied   Decimal          @db.Decimal(12, 2)
  appliedById     String?
  appliedBy       User?            @relation("CreditNoteApplicationAppliedBy", fields: [appliedById], references: [id])
  appliedAt       DateTime         @default(now())

  @@index([creditNoteId])
  @@index([purchaseOrderId])
  @@map("vendor_credit_note_applications")
}

// ------------------------------------------------------------
// SYSTEM SETTINGS (simple key/value store for admin settings page)
// ------------------------------------------------------------

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// One row per (product/variant, warehouse) — the source of truth for stock
model Inventory {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  quantityOnHand  Int       @default(0) // physically in warehouse
  quantityReserved Int      @default(0) // held for unfulfilled orders
  quantityDamaged Int       @default(0)

  // Book/ledger figures — what the accounts team believes should be in stock.
  // Normally mirrors the physical count; the two are allowed to drift so a
  // reconciliation workflow can surface and resolve discrepancies.
  accountingOnHand   Int    @default(0)
  accountingReserved Int    @default(0)

  reorderPoint    Int       @default(5)
  reorderQty      Int       @default(50)
  binLocation     String?

  updatedAt       DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  @@unique([productId, variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventories")
}

// Immutable ledger — every stock change is recorded here (audit trail)
model StockMovement {
  id            String            @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  productId     String
  variantId     String?
  type          StockMovementType
  quantity      Int               // positive = in, negative = out
  balanceAfter  Int
  reference     String?           // e.g. Purchase Order #, Order #, Adjustment note
  reason        String?
  performedById String?
  performedBy   User?             @relation(fields: [performedById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ------------------------------------------------------------
// ORDERS (minimal, for future build-out)
// ------------------------------------------------------------

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  customerId     String
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String?
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  couponCode     String?       // snapshot of the offer code applied at checkout, if any
  shippingFee    Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  shippingAddress Json
  addressId      String?
  address        Address?      @relation(fields: [addressId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          OrderItem[]
  shipment       Shipment?
  offerRedemption OfferRedemption?
  returnRequests  ReturnRequest[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

// ------------------------------------------------------------
// SHIPMENTS / PACKAGES / DELIVERY MANAGEMENT
// One Shipment per Order — represents the physical package moving
// from a Warehouse to the customer, with a status timeline and an
// optionally-assigned Delivery Agent.
// ------------------------------------------------------------

model Shipment {
  id               String         @id @default(uuid())
  shipmentNumber   String         @unique
  orderId          String         @unique
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])

  status           ShipmentStatus @default(CREATED)

  courierName      String?
  courierPhone     String?
  trackingNumber   String?

  packageWeightKg  Decimal?       @db.Decimal(8, 3)
  packageLengthCm  Decimal?       @db.Decimal(8, 2)
  packageWidthCm   Decimal?       @db.Decimal(8, 2)
  packageHeightCm  Decimal?       @db.Decimal(8, 2)

  deliveryAgentId  String?
  deliveryAgent    User?          @relation("ShipmentDeliveryAgent", fields: [deliveryAgentId], references: [id])

  shippingAddress  Json
  estimatedDeliveryDate DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  failureReason    String?
  notes            String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  events           ShipmentEvent[]

  @@index([warehouseId])
  @@index([status])
  @@index([deliveryAgentId])
  @@map("shipments")
}

// Immutable timeline of every status change for a shipment (tracking history)
model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  location   String?
  createdAt  DateTime       @default(now())

  @@index([shipmentId])
  @@map("shipment_events")
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int
  price       Decimal         @db.Decimal(12, 2)

  // The warehouse this line's stock was reserved from at checkout. Needed
  // later (ship/cancel/return) so the correct Inventory row is adjusted —
  // without this, a product stocked in multiple warehouses could have the
  // wrong warehouse's stock released/restocked.
  warehouseId String?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])

  // True once this line's reservation has been converted into an actual
  // physical stock removal (see fulfillReservation in inventory.service.js).
  // Lets order-status transitions know whether a later cancel/return should
  // release the reservation (never shipped) or restock physically (already shipped).
  fulfilled   Boolean         @default(false)

  returnRequestItems ReturnRequestItem[]

  @@map("order_items")
}

// ------------------------------------------------------------
// CUSTOMER RETURNS / REPLACEMENTS / REFUNDS
// A customer files one ReturnRequest per claim against a DELIVERED order,
// covering one or more of that order's line items (partial or full). The
// request carries either type:
//   RETURN       — item comes back, customer is refunded.
//   REPLACEMENT  — item comes back, a fresh unit is shipped out instead.
// Both share the same REQUESTED → APPROVED → PICKUP_SCHEDULED → PICKED_UP →
// RECEIVED spine (goods physically back in the warehouse), then fork:
// RETURN finishes at REFUNDED, REPLACEMENT continues to REPLACEMENT_SHIPPED
// → REPLACEMENT_DELIVERED. REJECTED/CANCELLED can end it early.
// ------------------------------------------------------------
model ReturnRequest {
  id            String              @id @default(uuid())
  requestNumber String              @unique
  orderId       String
  order         Order               @relation(fields: [orderId], references: [id])
  customerId    String
  customer      User                @relation("ReturnRequestCustomer", fields: [customerId], references: [id])

  type          ReturnRequestType
  reason        ReturnRequestReason
  status        ReturnRequestStatus @default(REQUESTED)

  customerNotes   String?
  staffNotes      String?
  rejectionReason String?

  // Populated once a RETURN is actually refunded.
  refundAmount  Decimal?      @db.Decimal(12, 2)
  refundMethod  RefundMethod?
  refundedAt    DateTime?

  // Populated once a REPLACEMENT unit actually ships back out.
  replacementCourierName    String?
  replacementTrackingNumber String?
  replacementShippedAt      DateTime?
  replacementDeliveredAt    DateTime?

  pickupScheduledAt DateTime?
  pickedUpAt        DateTime?
  receivedAt        DateTime?

  resolvedById String?
  resolvedBy   User?    @relation("ReturnRequestResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("return_requests")
}

// One line per order item covered by a return/replacement claim. quantity
// can be less than the OrderItem's original quantity (partial return); the
// controller sums across every non-REJECTED/CANCELLED request for an
// OrderItem to stop a customer from claiming the same unit twice.
model ReturnRequestItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2) // snapshot of OrderItem.price at request time

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_request_items")
}

// ------------------------------------------------------------
// OFFERS / COUPONS / DISCOUNTS
// A single model covers both kinds of promotion:
//  - COUPON offers require the customer to enter `code` at checkout.
//  - AUTOMATIC offers apply themselves to every qualifying cart/order,
//    so `code` is left null for those.
// `scope` + one of categoryId/brandId/productId narrows which items the
// discount applies to; ALL means the whole cart/order qualifies.
// ------------------------------------------------------------

model Offer {
  id                String        @id @default(uuid())
  title             String
  description       String?
  code              String?       @unique
  type              OfferType     @default(COUPON)
  discountType      DiscountType  @default(PERCENTAGE)
  discountValue     Decimal       @db.Decimal(12, 2)
  // Caps how much a PERCENTAGE discount can knock off in absolute terms
  // (e.g. "20% off, up to ₹500"). Ignored for FIXED discounts.
  maxDiscountAmount Decimal?      @db.Decimal(12, 2)
  // Cart/product subtotal must reach this amount for the offer to apply.
  minOrderAmount    Decimal       @default(0) @db.Decimal(12, 2)

  scope             OfferScope    @default(ALL)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id])
  brandId           String?
  brand             Brand?        @relation(fields: [brandId], references: [id])
  productId         String?
  product           Product?      @relation(fields: [productId], references: [id])

  startsAt          DateTime?
  endsAt            DateTime?
  // Total number of times this offer may ever be redeemed, across all
  // customers combined. Null = unlimited.
  usageLimit        Int?
  // Number of times a single customer may redeem this offer. Null = unlimited.
  usageLimitPerUser Int?
  usedCount         Int           @default(0)
  isActive          Boolean       @default(true)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  redemptions       OfferRedemption[]

  @@index([code])
  @@index([isActive])
  @@index([type])
  @@map("offers")
}

// One row per successful redemption — used both to enforce
// usageLimit/usageLimitPerUser and as an audit trail of which order got
// how much off from which offer.
model OfferRedemption {
  id             String   @id @default(uuid())
  offerId        String
  offer          Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  orderId        String?  @unique
  order          Order?   @relation(fields: [orderId], references: [id])
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  @@index([offerId])
  @@index([userId])
  @@map("offer_redemptions")
}

// ------------------------------------------------------------
// REVIEWS / PAYOUTS / NOTIFICATIONS / AUDIT
// ------------------------------------------------------------

// A customer may leave at most one review per product (enforced by the
// @@unique below, plus an application-level check that they actually have
// a DELIVERED order containing this product before allowing the write).
model Review {
  id         String         @id @default(uuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String
  customer   User           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  status     ApprovalStatus @default(APPROVED)
  createdAt  DateTime       @default(now())

  @@unique([productId, customerId])
  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

model Payout {
  id         String   @id @default(uuid())
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String?
  status     String   @default("PENDING")
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  @@map("payouts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
